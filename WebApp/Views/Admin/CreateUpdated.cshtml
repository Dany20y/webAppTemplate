@model WebApp.Models.UpdateCardM

@{
    Layout = "~/Views/Shared/AdminLayout.cshtml";
    ViewBag.Title = "Update Card";
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card mt-5">
            <div class="card-header">
                <h3 class="mb-0">Update Card</h3>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("CreateUpdated", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", id = "updateCardForm" }))
                {
                    @Html.AntiForgeryToken()

                    <!-- Title Field -->
                    <div class="form-group">
                        @Html.LabelFor(model => model.Title, "Title")
                        @Html.TextBoxFor(model => model.Title, new { @class = "form-control", placeholder = "Enter the title" })
                        @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                    </div>

                    <!-- Description Field -->
                    <div class="form-group">
                        @Html.LabelFor(model => model.Description, "Description")
                        @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = 4, placeholder = "Enter the description" })
                        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-dark rounded-pill">Update Card</button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Notification Toast -->
<div id="notification" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
        <div class="toast-body">
            @ViewBag.Message
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Display notification if message is set
        if (@ViewBag.Message != null) {
            $(".toast").toast({ delay: 3000 }).toast('show');
        }

        // Handle form submission via AJAX
        $("#updateCardForm").submit(function (event) {
            event.preventDefault(); // Prevent default form submission

            // Create a FormData object to handle form submission
            var formData = new FormData(this);

            $.ajax({
                url: "@Url.Action("CreateUpdated", "Admin")",
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    // Display notification
                    $(".toast").toast({ delay: 3000 }).toast('show');

                    // Optionally clear the form or handle response
                    if (response.success) {
                        $("#title").val(response.title);  // Update title field if needed
                        $("#description").val(response.description);  // Update description field if needed
                    } else {
                        // Display failure message in notification
                        $("#notification .toast-body").text(response.message);
                        $(".toast").toast({ delay: 3000 }).toast('show');
                    }
                },
                error: function (xhr, status, error) {
                    // Handle error
                    console.error(xhr.responseText);
                    $("#notification .toast-body").text("An error occurred: " + xhr.responseText);
                    $(".toast").toast({ delay: 3000 }).toast('show');
                }
            });
        });
    });
</script>
