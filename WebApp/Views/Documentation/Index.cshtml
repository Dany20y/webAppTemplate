@model IEnumerable<WebApp.Models.CompCard>

<div class="container">
    @foreach (var card in Model)
    {
        <div class="card" id="card-">
            <img src="@(card.img != null ? $"data:image/png;base64,{Convert.ToBase64String(card.img)}" : "placeholder.jpg")"
                 alt="@card.title"
                 onclick="zoomImage('@(card.img != null ? $"data:image/png;base64,{Convert.ToBase64String(card.img)}" : "placeholder.jpg")')">

            <div class="download-icon" onclick="downloadPDF('@(card.pdf_file != null ? $"data:application/pdf;base64,{Convert.ToBase64String(card.pdf_file)}" : "")')">
                <i class="fas fa-download"></i>
            </div>

            <div class="card-description">
                @card.description
            </div>
        </div>
    }
</div>

<div id="zoom-overlay" onclick="closeZoom()">
    <img src="" alt="Zoomed Image" id="zoomed-img">
</div>

<script>
    function zoomImage(src) {
        const overlay = document.getElementById('zoom-overlay');
        const zoomedImg = document.getElementById('zoomed-img');
        zoomedImg.src = src;
        overlay.style.display = 'flex';
    }

    function closeZoom() {
        const overlay = document.getElementById('zoom-overlay');
        overlay.style.display = 'none';
    }

    function downloadPDF(file) {
        if (!file) {
            alert("No PDF file to download.");
            return;
        }
        const link = document.createElement('a');
        link.href = file;
        link.download = 'download.pdf';
        link.click();
    }
</script>
